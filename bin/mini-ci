#!/usr/bin/env ruby
# frozen_string_literal: true

begin
  begin
    require "mini_ci"
  rescue LoadError
    require_relative "../lib/mini_ci"
  end

  exit MiniCi::CLI.new(arguments: ARGV).call
rescue Interrupt
  warn "Mini CI interrupted."
  exit MiniCi::ExitCode::INTERRUPTED
rescue Errno::EPIPE
  exit MiniCi::ExitCode::SUCCESS
end
