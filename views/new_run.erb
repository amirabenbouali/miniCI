<section class="section-heading">
  <h1>Start a pipeline</h1>
</section>

<form class="run-form" method="post" action="/runs">
  <input type="hidden" name="csrf_token" value="<%= h(csrf_token) %>">
  <label>
    Pipeline file
    <input name="pipeline_file" value="pipeline.yml" required>
  </label>
  <label>
    Concurrency
    <input name="concurrency" placeholder="automatic">
  </label>
  <label class="checkbox">
    <input type="checkbox" name="no_cache">
    Disable cache
  </label>
  <label>
    Plugin files
    <textarea name="plugin_files" rows="4" placeholder="examples/plugins/run_logger.rb"></textarea>
  </label>
  <label>
    Plugin directories
    <textarea name="plugin_dirs" rows="4"></textarea>
  </label>
  <button type="submit">Run pipeline</button>
</form>
