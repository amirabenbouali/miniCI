<section class="section-heading">
  <h1>Runs</h1>
  <a class="button" href="/run/new">Start run</a>
</section>

<form class="filters" method="get" action="/runs">
  <label>
    Status
    <select name="status">
      <option value="">Any</option>
      <% %w[queued running passed failed cancelled internal_error].each do |status| %>
        <option value="<%= h(status) %>" <%= "selected" if status == @status %>><%= h(status) %></option>
      <% end %>
    </select>
  </label>
  <label>
    Pipeline
    <input name="pipeline" value="<%= h(@pipeline) %>">
  </label>
  <button type="submit">Filter</button>
</form>

<%= erb :_run_table, locals: { runs: @runs } %>
