<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <% if defined?(@run) && @run && %w[queued running].include?(@run["status"]) %>
      <meta http-equiv="refresh" content="3">
    <% end %>
    <title>Mini CI Dashboard</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/">Mini CI</a>
      <nav>
        <a href="/runs">Runs</a>
        <a href="/run/new">New run</a>
      </nav>
    </header>
    <main class="page">
      <%= yield %>
    </main>
  </body>
</html>
